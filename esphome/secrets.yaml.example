# Copy to secrets.yaml (gitignored) and fill in.
wifi_ssid: "MyWiFi"
wifi_password: "wifi-password"

# MQTT broker the ESP32 and mqtt-listen.py talk to (e.g. the Homey MQTT Broker app or Mosquitto)
mqtt_broker: "192.168.1.10"
mqtt_user: "user"
mqtt_password: "password"

# The lock's Bluetooth MAC (shown as "Lock MAC" in the Homey device settings)
ttlock_lock_mac: "AA:BB:CC:DD:EE:FF"

# From `npm run bridge-credentials` (phase 4b step 3, not needed for the passive measurement)
ttlock_aes_key: "00112233445566778899aabbccddeeff"
ttlock_admin_ps: 0
ttlock_unlock_key: 0
